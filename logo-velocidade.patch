From 6b6cb8eaad4742147cc71c1da09e12ecedced8a0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 24 Sep 2026 21:03:11 -0300
Subject: [PATCH 2/2] Velocidade e identidade: cache curto de leituras,
 carregamento sob demanda e cores da marca
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- api.js: leituras iguais em 30s reaproveitam a resposta; qualquer escrita
  (ou o assistente) limpa o cache. mockData só é baixado no modo demo.
- saida.js: as 3 consultas agora em paralelo.
- etiquetas.js: biblioteca de QR Code só carrega nessa tela (sai do index.html).
- style.css: cores da marca do site; gráfico entrada=ciano, saída=laranja;
  faixa de cores da marca sob o logo e no card de login.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MqLjGDqAa1zSoWsQHyfTCK
---
 public/css/style.css         | 21 +++++++-
 public/index.html            |  1 -
 public/js/api.js             | 93 +++++++++++++++++++++++-------------
 public/js/views/etiquetas.js | 18 ++++++-
 public/js/views/saida.js     |  6 +--
 5 files changed, 99 insertions(+), 40 deletions(-)

diff --git a/public/css/style.css b/public/css/style.css
index ecb3f72..f185357 100644
--- a/public/css/style.css
+++ b/public/css/style.css
@@ -30,8 +30,15 @@
   --danger-soft: rgba(221, 82, 77, 0.16);
   --danger-text: #f1837e;
 
-  --series-entrada: #4c9fe8;
-  --series-saida: #d9a238;
+  /* Cores da marca (site waterloo.com.br) */
+  --marca-azul: #144380;
+  --marca-azul-acinzentado: #97adc7;
+  --marca-ciano: #36bde4;
+  --marca-verde: #81bb27;
+  --marca-laranja: #e95017;
+
+  --series-entrada: var(--marca-ciano);
+  --series-saida: var(--marca-laranja);
 
   --radius-sm: 8px;
   --radius-md: 12px;
@@ -106,6 +113,16 @@ p { line-height: 1.55; }
   border-bottom: 1px solid var(--border);
   color: var(--text-primary);
 }
+.sidebar-brand { position: relative; }
+.sidebar-brand::after, .login-box .card::before {
+  content: ''; position: absolute; left: 0; right: 0; height: 3px;
+  background: linear-gradient(90deg,
+    var(--marca-azul-acinzentado) 0 25%, var(--marca-ciano) 25% 50%,
+    var(--marca-verde) 50% 75%, var(--marca-laranja) 75% 100%);
+}
+.sidebar-brand::after { bottom: -1px; }
+.login-box .card { position: relative; overflow: hidden; }
+.login-box .card::before { top: 0; }
 .sidebar-brand .logo-icone {
   width: 34px; height: 34px;
   display: flex; align-items: center; justify-content: center;
