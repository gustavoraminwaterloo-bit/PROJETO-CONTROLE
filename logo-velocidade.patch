+// A biblioteca de QR Code só é baixada quando alguém abre esta tela.
+let carregandoQr = null;
+function carregarQrcode() {
+  if (typeof window.qrcode === 'function') return Promise.resolve();
+  if (!carregandoQr) {
+    carregandoQr = new Promise((resolve, reject) => {
+      const s = document.createElement('script');
+      s.src = 'https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js';
+      s.onload = resolve;
+      s.onerror = () => { carregandoQr = null; reject(new Error('Não foi possível carregar o gerador de QR Code.')); };
+      document.head.appendChild(s);
+    });
+  }
+  return carregandoQr;
+}
